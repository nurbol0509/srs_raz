        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman API Course\",\n  \"slug\": \"postman-{{runId}}\",\n  \"description\": \"Postman generated course for CRUD demonstration.\",\n  \"teacher_id\": 1,\n  \"category\": \"Testing\",\n  \"level\": \"beginner\",\n  \"price\": \"expensive\",\n  \"duration_hours\": 12,\n  \"status\": \"published\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Duplicate slug",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/courses",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman API Course\",\n  \"slug\": \"postman-{{runId}}\",\n  \"description\": \"Postman generated course for CRUD demonstration.\",\n  \"teacher_id\": 1,\n  \"category\": \"Testing\",\n  \"level\": \"beginner\",\n  \"price\": 12000,\n  \"duration_hours\": 12,\n  \"status\": \"published\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
