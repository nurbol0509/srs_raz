      "name": "17 Delete enrollment and its progress",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/enrollments/{{enrollmentId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Delete lesson",
      "request": {
        "method": "DELETE",
