    {
      "name": "15 Missing record",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/courses/999999",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Referenced course cannot be deleted",
      "request": {
        "method": "DELETE",
