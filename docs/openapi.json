  "components": {
    "schemas": {
      "teachersInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "specialty"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "specialty": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        }
      },
      "studentsInput": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "coursesInput": {
        "type": "object",
        "required": [
          "title",
          "slug",
          "description",
          "teacher_id",
          "category",
          "level",
          "price",
          "duration_hours",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 3000
          },
          "teacher_id": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "duration_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          }
        }
      },
      "lessonsInput": {
        "type": "object",
        "required": [
          "course_id",
          "title",
          "content",
          "position",
          "duration_minutes"
        ],
        "additionalProperties": false,
        "properties": {
          "course_id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "content": {
            "type": "string",
            "minLength": 5,
            "maxLength": 10000
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "enrollmentsInput": {
        "type": "object",
        "required": [
          "student_id",
          "course_id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "student_id": {
            "type": "integer",
            "minimum": 1
          },
          "course_id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "cancelled"
            ]
          }
        }
      },
      "progressInput": {
        "type": "object",
        "required": [
          "enrollment_id",
          "lesson_id",
          "completed"
        ],
        "additionalProperties": false,
        "properties": {
          "enrollment_id": {
            "type": "integer",
            "minimum": 1
          },
          "lesson_id": {
            "type": "integer",
            "minimum": 1
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}