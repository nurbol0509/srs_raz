<%- include('partials/header') %><a class="back" href="/">← Курс каталогы</a><div class="detail-layout"><section><p class="eyebrow"><%= course.category %> · <%= levels[course.level] %></p><h1 class="detail-title"><%= course.title %></h1><p class="lead"><%= course.description %></p><div class="teacher"><span class="avatar"><%= teacher.name.slice(0,1) %></span><div><strong><%= teacher.name %></strong><br><small><%= teacher.specialty %></small></div></div><h2>Курс бағдарламасы</h2><div class="lesson-list"><% lessons.forEach(l=>{ %><details class="lesson"><summary><span class="number"><%= String(l.position).padStart(2,'0') %></span><strong><%= l.title %></strong><small><%= l.duration_minutes %> мин</small></summary><p><%= l.content %></p></details><% }) %><% if(!lessons.length){ %><p>Сабақтар әлі қосылмаған.</p><% } %></div></section><aside class="panel sticky"><span class="tag"><%= course.status==='published'?'Тіркелу ашық':'Тіркелу жабық' %></span><h2><%= course.price===0?'Тегін':course.price.toLocaleString('kk-KZ')+' ₸' %></h2><p><%= course.duration_hours %> сағат · <%= lessons.length %> сабақ</p><hr><form id="enroll-form" data-course-id="<%= course.id %>"><label for="student">Студентті таңдаңыз</label><select id="student" name="student_id" required><option value="">Таңдаңыз</option><% students.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select><button class="button full" <%= course.status!=='published'?'disabled':'' %>>Курсқа тіркеу</button></form><p class="muted small">Бұл демонстрациялық платформа. Төлем қабылданбайды.</p><a href="/manage">Жаңа студент қосу →</a></aside></div><%- include('partials/footer') %>
