<%- include('partials/header') %><p class="eyebrow">НӘТИЖЕҢІЗДІ БАҚЫЛАҢЫЗ</p><h1 class="detail-title">Оқу прогресі</h1><p class="lead">Сабақты аяқтаған соң белгі қойыңыз. Прогресс деректер қорында сақталады.</p><div class="learning-grid"><% enrollments.forEach(item=>{ %><article class="panel"><div class="section-head"><div><span class="tag"><%= item.enrollment.status==='active'?'Белсенді':'Тоқтатылған' %></span><h2><%= item.course.title %></h2><p><%= item.student.name %></p></div><strong class="percent"><%= item.percent %>%</strong></div><progress max="100" value="<%= item.percent %>"><%= item.percent %>%</progress><p class="muted"><%= item.completed_lessons %> / <%= item.total_lessons %> сабақ аяқталды</p><% item.lessons.forEach(lesson=>{const p=item.progress.find(p=>p.lesson_id===lesson.id);%><label class="check-row"><input type="checkbox" class="completion" data-enrollment="<%= item.enrollment.id %>" data-lesson="<%= lesson.id %>" data-progress="<%= p?p.id:'' %>" <%= p&&p.completed?'checked':'' %> <%= item.enrollment.status!=='active'?'disabled':'' %>><span><%= lesson.title %></span><small><%= lesson.duration_minutes %> мин</small></label><% }) %></article><% }) %><% if(!enrollments.length){ %><p class="empty">Әзірге тіркелу жоқ. <a href="/">Курс таңдаңыз.</a></p><% } %></div><%- include('partials/footer') %>
