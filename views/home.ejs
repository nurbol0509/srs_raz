<%- include('partials/header') %>
<section class="hero"><div><p class="eyebrow">БІЛІМГЕ БІР ҚАДАМ ЖАҚЫН</p><h1>Жаңа дағды.<br><em>Жаңа мүмкіндік.</em></h1><p class="lead">Курсты таңдаңыз, сабақтарды меңгеріңіз және оқу прогресін бір жерден бақылаңыз.</p><a class="button" href="#catalog">Курстарды қарау <span>↗</span></a></div><div class="hero-art" aria-hidden="true"><div class="orb"></div><div class="art-card"><span class="mini-label">ӨСУ ЖОЛЫ</span><div class="steps"><i></i><i></i><i></i><i></i></div><strong>Бүгінгі қадам —<br>ертеңгі нәтиже.</strong><span class="art-star">✳</span></div><span class="floating">↗ Үйренуді жалғастыр</span></div></section>
<section class="metrics" aria-label="Статистика"><div><strong><%= counts.courses %></strong><span>курс каталогта</span></div><div><strong><%= counts.students %></strong><span>студент тіркелген</span></div><div><strong><%= counts.enrollments %></strong><span>курсқа тіркелу</span></div></section>
<section id="catalog"><div class="section-head"><div><p class="eyebrow">ӨЗ БАҒЫТЫҢЫЗДЫ ТАҢДАҢЫЗ</p><h2>Курс каталогы</h2></div><form class="search" action="/" method="get"><label class="sr-only" for="q">Курсты іздеу</label><input id="q" name="q" value="<%= q %>" placeholder="Курс атауы немесе тақырып"><button>Іздеу</button></form></div>
<div class="cards"><% courses.forEach((course,i)=>{ const teacher=teachers.find(t=>t.id===course.teacher_id); %><article class="course-card"><div class="cover cover-<%= i%3 %>"><span><%= course.category %></span><b><%= course.category==='Бағдарламалау'?'</>':course.category==='Деректер'?'▥':'Aa' %></b><small><%= levels[course.level] %></small></div><div class="card-body"><div class="meta"><%= course.duration_hours %> сағат <span>·</span> <%= course.status==='published'?'Жарияланған':course.status==='draft'?'Жоба':'Архив' %></div><h3><a href="/courses/<%= course.id %>"><%= course.title %></a></h3><p><%= course.description %></p><div class="teacher"><span class="avatar"><%= teacher.name.slice(0,1) %></span><%= teacher.name %></div><div class="card-bottom"><strong><%= course.price===0?'Тегін':course.price.toLocaleString('kk-KZ')+' ₸' %></strong><a href="/courses/<%= course.id %>">Толығырақ ↗</a></div></div></article><% }) %></div><% if(!courses.length){ %><p class="empty">Курс табылмады. Басқа сөзбен іздеңіз немесе <a href="/">барлық курсты ашыңыз</a>.</p><% } %></section>
<%- include('partials/footer') %>
